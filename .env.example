# Copy this file to .env and fill in values. .env is ignored by git.
# Every variable is optional: with none set, the app runs with a fake PayPal
# and the rules-only risk engine.

# --- PayPal ---
# "fake" = in-process fake PayPal (no credentials needed)
# "sandbox" = real PayPal sandbox (needs the values below)
PAYPAL_MODE=fake
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox test card used as payment_source.card (sandbox only, never a real card)
# Expiry format is YYYY-MM, for example 2030-01
SANDBOX_CARD_NUMBER=
SANDBOX_CARD_EXPIRY=
SANDBOX_CARD_SECURITY_CODE=
SANDBOX_CARD_NAME=

# --- AI risk analysis ---
# "gemini" = live calls (needs GEMINI_API_KEY)
# "replay" = no key needed: serves the stored replies in AI_CACHE_DIR (use demo/ai-cache for the
#            three demo messages); any other message is checked by the rules alone
# "none"   = rules only
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_SECONDS=8
# Optional: reuse stored AI replies for identical prompts (helps stay inside free-tier limits).
# Leave empty to always call the model.
AI_CACHE_DIR=

# --- Holds ---
# How long a held or warned payment waits before it is voided.
# 86400 = 24 hours (default). Use 120 for demo recordings.
HOLD_TIMEOUT_SECONDS=86400
# How often the background sweeper voids expired holds and retries failed voids.
SWEEPER_INTERVAL_SECONDS=5

# --- App ---
DATABASE_PATH=data/safepay.db
CORS_ORIGINS=http://localhost:5173
